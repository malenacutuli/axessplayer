# apps/studio env SCHEMA. VITE_* vars are inlined at BUILD time and are PUBLIC. Names only, never values.
# Set as Vercel project env (Preview and Production separately) or as docker --build-arg. See infra/ENV.md.
# No em dashes.

VITE_CONTENT_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Identity service: links a creator's Supabase login to their profile (POST /auth/verify).
VITE_IDENTITY_BASE_URL=
VITE_CATALOG_BASE_URL=
VITE_GENERATION_BASE_URL=
VITE_INGESTION_BASE_URL=
# Dev builds only (local stacks with the test verifier); ignored by production builds.
VITE_CREATOR_SESSION_TOKEN=
