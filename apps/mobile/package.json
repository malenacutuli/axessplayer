{
  "name": "@axessplayer/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Expo (iOS + Android) consumer app: TikTok-style Shorts feed, Netflix-style Home rows, accessible Watch player (expo-video HLS), Supabase sign-in, tips, sponsor disclosure. Pure logic in src/core is tested with node:test + tsx. No em dashes.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "doctor": "npx expo-doctor",
    "build": "echo build ok",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo lint ok",
    "test": "node --import tsx --test $(find src -name '*.test.ts' 2>/dev/null)"
  },
  "dependencies": {
    "@axessplayer/player-sdk": "workspace:*",
    "@expo/log-box": "^57.0.4",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@axessplayer/contracts": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "~19.2.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "main": "expo-router/entry"
}
