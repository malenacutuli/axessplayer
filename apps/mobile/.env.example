# apps/mobile env SCHEMA. EXPO_PUBLIC_* vars are inlined into the JS bundle at build time and are PUBLIC.
# Never put a secret here. Copy to .env.local for local dev (gitignored). Set per EAS build profile for
# store builds (DEPLOY_RUNBOOK.md B). See infra/ENV.md. No em dashes.
#
# Defaults in src/core/config/env.ts apply when a value is empty, except the Supabase anon key: with no
# anon key the app runs guest-only (everything is watchable; sign-in, tipping and library are hidden).

# Content service: /feed/shorts, /feed/home, /videos/:id, /videos/:id/playback
EXPO_PUBLIC_CONTENT_BASE_URL=https://axessplayer-content.onrender.com
# Economy service: POST /tips
EXPO_PUBLIC_ECONOMY_BASE_URL=https://axessplayer-economy.onrender.com
# Events service: POST /events (sent only after the viewer accepts analytics consent)
EXPO_PUBLIC_EVENTS_BASE_URL=https://axessplayer-events.onrender.com
# Supabase Auth (email + password). The anon key is public but is still read from env, never committed.
EXPO_PUBLIC_SUPABASE_URL=https://faeyekynudyzeotbjfsj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Development only: 1 swaps the content client for the in-memory mock with public HLS test streams.
EXPO_PUBLIC_USE_MOCKS=
