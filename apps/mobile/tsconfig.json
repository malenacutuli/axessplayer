{
  // Expo base (bundler resolution, react-jsx) plus strict mode. The legacy v1 modules in src/api,
  // src/feed, src/wallet, src/player, src/accessibility bind type-only to the generated contract types,
  // so those files are included here (run `pnpm gen` at the repo root first). No em dashes.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": [
    "app",
    "src",
    "../../contracts/types/generated/economy.ts",
    "../../contracts/types/generated/content.ts",
    "../../contracts/types/generated/decision.ts",
    "../../contracts/types/generated/manifest.ts"
  ]
}
