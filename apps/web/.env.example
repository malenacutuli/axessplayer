# Configurable base URLs for the live services (or one Prism gateway in the mock environment).
# Copy to .env.local and point at mocks, staging, or production. The build embeds VITE_ vars.
# Identity is carried by the session token, never by a request body (F1).

# One gateway in the mock/dev case; in production each may be its own origin.
VITE_CONTENT_BASE_URL=http://localhost:4010
VITE_ECONOMY_BASE_URL=http://localhost:4010
VITE_DECISION_BASE_URL=http://localhost:4010
VITE_MANIFEST_BASE_URL=http://localhost:4010
