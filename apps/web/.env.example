# Configurable base URLs for the live services (or one Prism gateway in the mock environment).
# Copy to .env.local and point at mocks, staging, or production. The build embeds VITE_ vars.
# Identity is carried by the session token, never by a request body (F1).

# One gateway in the mock/dev case; in production each may be its own origin.
VITE_CONTENT_BASE_URL=http://localhost:4010
VITE_ECONOMY_BASE_URL=http://localhost:4010
VITE_DECISION_BASE_URL=http://localhost:4010
VITE_MANIFEST_BASE_URL=http://localhost:4010

# The session bearer token (the viewer identity). In production this is the Supabase access token.
VITE_SESSION_TOKEN=demo-session-token

# Optional: a real video clip for the player poster surface. When set, the player renders a muted
# autoplaying looping <video> as the full-bleed surface (captions/overlay on top), seeked per cut, so
# a provided clip plays through the cuts. When unset, the gradient poster is used.
# VITE_SCENE_VIDEO_URL=/scene.mp4

# Engagement events collector (services/events). When set, consent-gated capture ships here.
VITE_EVENTS_BASE_URL=http://127.0.0.1:8098
