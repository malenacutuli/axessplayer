# Production build config for apps/web (humanaxess.com). Vite inlines VITE_* vars at build time and they are
# PUBLIC by design: service origins plus the Supabase project URL and public anon key (never a secret key).
# Committed so a production build never depends on dashboard-only variables (on 2026-10-01 a build without
# them shipped a web app pointing at its own origin). Override per environment in the Vercel dashboard.
VITE_CONTENT_BASE_URL=https://axessplayer-content.onrender.com
