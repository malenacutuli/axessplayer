VITE_EVENTS_BASE_URL=https://axessplayer-events.onrender.com
VITE_IDENTITY_BASE_URL=https://axessplayer-identity.onrender.com
VITE_CONSENT_BASE_URL=https://axessplayer-identity.onrender.com
