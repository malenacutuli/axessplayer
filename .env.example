# Axessplayer server runtime env SCHEMA. Names only, NEVER values. Copy to .env and fill from your secret
# store. See infra/ENV.md for the full catalog. Do not commit a filled .env. No em dashes.

# --- Database / Supabase (server, runtime) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Auth / JWT verification (server, runtime) ---
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# --- KV / Redis serving cache (server, runtime). Absent => in-memory default. ---
KV_URL=
REDIS_URL=

# --- CDN / delivery (server, runtime) ---
CDN_ORIGIN=
DRM_LICENSE_URL=

# --- Stripe / payments (server, runtime). Use a TEST key until launch. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Service runtime knobs ---
PORT=
NODE_ENV=
GENERATION_ALLOW_REAL_SPEND=
