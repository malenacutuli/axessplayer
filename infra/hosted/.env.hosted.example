# Hosted env template for running the axessplayer services against the SHARED Supabase
# project faeyekynudyzeotbjfsj, isolated `mobile` schema. No em dashes.
#
# SECURITY: copy this to infra/hosted/.env.hosted (gitignored) and fill the real values from the
# Supabase dashboard. NEVER put real secrets in this .example file and NEVER commit .env.hosted.
#
# Load it before starting a service (values stay in your shell, not in git):
#   set -a && source infra/hosted/.env.hosted && set +a
#   PORT=8093 pnpm --filter @axessplayer/content  serve
#   PORT=8091 pnpm --filter @axessplayer/economy  serve
#   PORT=8092 pnpm --filter @axessplayer/decision serve

# Postgres connection, session mode (port 5432). Password from Supabase dashboard > Database > Connection.
# For transaction mode use the pooler host on 6543. Do not commit the filled value.
DATABASE_URL=postgres://postgres:<password>@db.faeyekynudyzeotbjfsj.supabase.co:5432/postgres

# Resolve unqualified table names to the isolated mobile schema, applied per connection by the service
# pool (services/*/src/server.ts). Leave exactly as below. The ledger RPCs are immune (search_path='').
DB_OPTIONS=-c search_path=mobile,public

# Supabase REST origin and service-role key (for edge functions and storage reuse). Service role is a
# secret: fill only in .env.hosted, never here.
SUPABASE_URL=https://faeyekynudyzeotbjfsj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<from dashboard, secret>

# Economy service-to-service bearer the /grant verifier accepts (any strong non-production secret).
ECONOMY_SERVICE_SECRET=<choose a strong secret>
